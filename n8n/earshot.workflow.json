{
  "name": "Earshot: voice of customer on demand",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "earshot",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook: run for a URL",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "earshot-run"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "name": "Every Monday 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "url",
              "value": "https://your-company.com",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "competitors",
              "value": "Competitor A, Competitor B",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Company to track",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8090/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.body?.url ?? $json.url, competitors: ($json.body?.competitors ?? $json.competitors ?? '').toString().split(',').map(s => s.trim()).filter(Boolean), demo: $json.body?.demo ?? false }) }}",
        "options": {
          "timeout": 600000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Api-Token",
              "value": "PASTE_THE_SAME_TOKEN_AS_IN_YOUR_.env"
            }
          ]
        }
      },
      "name": "Run Earshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE_YOUR_SLACK_INCOMING_WEBHOOK_URL",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.summary }) }}",
        "options": {}
      },
      "name": "Post summary to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        100
      ],
      "notes": "Replace the URL with your Slack incoming webhook, or delete this node.",
      "continueOnFail": true
    }
  ],
  "connections": {
    "Webhook: run for a URL": {
      "main": [
        [
          {
            "node": "Run Earshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every Monday 07:00": {
      "main": [
        [
          {
            "node": "Company to track",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Company to track": {
      "main": [
        [
          {
            "node": "Run Earshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Earshot": {
      "main": [
        [
          {
            "node": "Post summary to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}