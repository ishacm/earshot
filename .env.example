# Copy to .env and fill in. .env is git-ignored and never committed.
# Free mode: a Groq key from console.groq.com
GROQ_API_KEY=
# Optional, for the Reddit source (app-only OAuth, create a "script" app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional, to post the summary to Slack
SLACK_WEBHOOK_URL=
# Optional, paid providers are refused unless this is "true"
EARSHOT_ALLOW_PAID=false
EARSHOT_API_TOKEN=                # set this if the API listens beyond localhost (e.g. for n8n in Docker)
